# Copy to .env and fill in. Never commit the real file.
#
# Nothing here is required to run in paper mode against mainnet. The bot boots on the
# public RPC with no keys at all; every value below either upgrades reliability or
# unlocks live trading.

# ---------------------------------------------------------------------------
# RPC. The public endpoint is rate-limited and rejects websocket upgrades, which
# is fine for paper evaluation and not fine for live trading. Live mode refuses
# to start until RHC_RPC_HTTP_URL points somewhere else.
# ---------------------------------------------------------------------------
# RHC_RPC_HTTP_URL=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY
# RHC_RPC_WS_URL=wss://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY

# ---------------------------------------------------------------------------
# Execution key. LIVE MODE ONLY.
#
# This wallet should hold trading capital and nothing else — size it as the most
# you are willing to lose to a bug or a compromise, and keep the treasury
# somewhere this process cannot reach. Never put this in a config file.
# ---------------------------------------------------------------------------
# EXECUTION_PRIVATE_KEY=0x...

# ---------------------------------------------------------------------------
# Telegram alerts and /pause, /resume, /status, /kill control.
# ---------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=123456789:AA...
# TELEGRAM_CHAT_ID=-1001234567890

# ---------------------------------------------------------------------------
# Optional third-party enrichment. Vetting falls back to on-chain simulation
# when these are absent, and never passes a token because a scanner was down.
# ---------------------------------------------------------------------------
# GOPLUS_API_KEY=
# BITQUERY_API_KEY=

# ---------------------------------------------------------------------------
# Overrides config/bot.json. Deliberately explicit: flipping to live is a
# decision, not a default.
# ---------------------------------------------------------------------------
# TRADING_MODE=paper
# LOG_LEVEL=info
# LOG_FORMAT=json
