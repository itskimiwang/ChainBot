  "chain": {
    "id": 4663,
    "name": "Robinhood Chain",
    "shortName": "rhc",
    "stack": "arbitrum-orbit",
    "nativeCurrency": { "name": "Ether", "symbol": "ETH", "decimals": 18 },
    "approxBlockTimeMs": 100,
    "explorer": {
      "name": "Blockscout",
      "url": "https://robinhoodchain.blockscout.com",
      "apiUrl": "https://robinhoodchain.blockscout.com/api"
    },
    "docs": "https://docs.robinhood.com/chain",
    "testnet": {
      "id": 46630,
      "note": "Exists for contract-interaction debugging only. Not a required stage: paper mode against mainnet is the validation path (see docs/RUNBOOK.md)."
    }
  },

  "rpc": {
    "primary": {
      "http": "https://rpc.mainnet.chain.robinhood.com",
      "ws": null,
      "tier": "public",
      "rateLimited": true,
      "supportsWebsocket": false,
      "supportsLogSubscription": false,
      "note": "Verified reachable and correct (eth_chainId -> 0x1237). Rate-limited, and the HTTPS endpoint rejects websocket upgrades, so the listener falls back to log polling. Adequate for paper evaluation, NOT for production live trading."
    },
    "overrideEnvVars": {
      "http": "RHC_RPC_HTTP_URL",
      "ws": "RHC_RPC_WS_URL"
    },
    "dedicatedProviders": [
      { "name": "Alchemy", "websocket": true, "webhooks": true, "gasSponsorship": true },
      { "name": "QuickNode", "websocket": true, "webhooks": false, "gasSponsorship": false },
      { "name": "Chainstack", "websocket": true, "webhooks": false, "gasSponsorship": false }
    ],
    "sequencer": {
      "orderingConfirmed": false,
      "assumedOrdering": "fcfs-no-public-mempool",
      "note": "LOAD-BEARING AND UNCONFIRMED. The colocation thesis in docs/RUNBOOK.md depends on this. Confirm against docs.robinhood.com/chain before provisioning a colocated host or going live. Treat 'private sequencer, no public mempool' as an assumption, not a fact."
    }
  },

