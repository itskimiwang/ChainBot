  "externalApis": {
    "bitquery": {
      "enabled": false,
      "endpoint": "https://streaming.bitquery.io/graphql",
      "apiKeyEnvVar": "BITQUERY_API_KEY",
      "network": "robinhood",
      "note": "Purpose-built Pons coverage (Trading cube, protocol pons_v2). Optional accelerator for the listener and for Phase 3 historical backfill. The RPC adapter is self-sufficient without it."
    },
    "goplus": {
      "enabled": true,
      "endpoint": "https://api.gopluslabs.io/api/v1",
      "apiKeyEnvVar": "GOPLUS_API_KEY",
      "chainSupportConfirmed": false,
      "note": "GoPlus may not cover chain 4663. The vetting service treats it as an optional enrichment provider: if it 404s or omits the chain, vetting falls back to on-chain eth_call simulation, which is the authoritative honeypot check either way. Vetting must never pass a token solely because an external API was unreachable."
    },
    "madeonsol": {
      "enabled": false,
      "endpoint": null,
      "apiKeyEnvVar": "MADEONSOL_API_KEY",
      "note": "Third-party deployer-reputation / tracked-wallet / risk-score API flagged in the spec as a possible shortcut for Phases 2-3. Left disabled pending the evaluation in docs/PHASE-2-3-BUILD-VS-BUY.md. Wire it as a DeployerScoreProvider rather than replacing the local graph: the local DB keeps accruing value and stays available if the vendor changes terms."
    },
    "gmgn": {
      "enabled": false,
      "endpoint": null,
      "note": "Watcher-count demand-velocity proxy referenced by Phase 4. No confirmed Robinhood Chain coverage, so the decision engine's default demand-velocity signal is computed on-chain from unique-buyer velocity instead."
    }
  }
